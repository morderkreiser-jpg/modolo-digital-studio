# Modello delle variabili d'ambiente del sito.
#
# Next.js NON legge questo file. In locale copialo in .env.local e compila solo
# quello che ti serve. Su Vercel le stesse variabili vanno in Settings ->
# Environment Variables, e dopo ogni modifica serve un nuovo deploy (Redeploy).
#
# Il repository è pubblico: in questo file mai valori veri.
# Le righe che iniziano con "#" sono facoltative: togli il "#" solo per cambiare
# il valore predefinito che vedi scritto.
# Guida completa all'assistente AI: docs/assistant/README.md


# ============================================================================
# Assistente AI (Anthropic Claude)
# ============================================================================

# Chiave API di Anthropic (Claude Console -> API keys). Obbligatoria per
# l'assistente: vuota = assistente spento e nessun bottone della chat.
ANTHROPIC_API_KEY=

# Interruttore d'emergenza: "false" spegne chat e widget senza togliere la chiave.
# ASSISTANT_ENABLED=true

# Modello principale, veloce ed economico.
# ASSISTANT_MODEL=claude-haiku-5-5

# Modello avanzato facoltativo: claude-sonnet-5-5 oppure claude-opus-5-5.
# Serve solo se ASSISTANT_MODEL_ROUTING è "advanced" o "auto".
# ASSISTANT_MODEL_ADVANCED=claude-sonnet-5-5

# fast = sempre il modello principale; advanced = sempre il modello avanzato;
# auto = il modello avanzato solo per le domande lunghe (oltre 400 caratteri)
# o con almeno tre punti interrogativi.
# ASSISTANT_MODEL_ROUTING=fast

# Quanto ragiona il modello prima di rispondere: low, medium o high.
# Più alto = più lento e più caro.
# ASSISTANT_EFFORT=low

# Token massimi in uscita per risposta (256-4096), ragionamento interno compreso.
# ASSISTANT_MAX_OUTPUT_TOKENS=2048

# Attesa massima per una risposta, in millisecondi (5000-120000). Su Vercel la
# funzione della chat dura al massimo 60 secondi: oltre 55000 non serve.
# ASSISTANT_TIMEOUT_MS=30000

# --- Limiti di spesa e di traffico --------------------------------------------
# Valgono per tutti i tenant e hanno la precedenza sui valori scritti nel codice.
# Il tetto di spesa vero si imposta nella Claude Console (Spend limits).

# Spesa stimata massima in dollari: per giorno (UTC) e per mese di calendario.
# ASSISTANT_DAILY_BUDGET_USD=1
# ASSISTANT_MONTHLY_BUDGET_USD=15

# Richieste chat al giorno (tutti i visitatori insieme) e messaggi per conversazione.
# ASSISTANT_DAILY_REQUEST_LIMIT=1000
# ASSISTANT_SESSION_MESSAGE_LIMIT=30

# --- Sicurezza e amministrazione ----------------------------------------------

# Segreto con cui IP ed email vengono pseudonimizzati (hash) nei contatori.
# Se manca viene ricavato dalla chiave Anthropic. In produzione è meglio un
# valore casuale lungo, da generare con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ASSISTANT_HASH_SALT=

# Token per leggere i consumi su /api/assistant/usage: almeno 24 caratteri,
# casuale (stesso comando di sopra). Se manca, l'indirizzo risponde 404.
# ASSISTANT_ADMIN_TOKEN=

# --- Richieste di preventivo --------------------------------------------------

# Giorni di conservazione dei preventivi (1-3650): il numero scritto accanto
# alla casella del modulo e nell'email, e la scadenza delle copie su Upstash.
# Se manca vale il valore del tenant (Modolo: 365, i 12 mesi dell'informativa:
# se lo cambi, cambia anche l'informativa).
# ASSISTANT_LEAD_RETENTION_DAYS=365

# Copia dei preventivi su Upstash: "true" salva ogni richiesta anche nel
# database, con la scadenza qui sopra. Serve Upstash (blocco più in basso);
# senza "true" Upstash tiene solo i contatori. Prima di attivarla aggiorna
# l'informativa (docs/assistant/README.md, sezione 10).
# ASSISTANT_LEAD_COPY=false

# Destinatario delle email dei preventivi. Sostituisce l'indirizzo del tenant
# (Modolo: info@modolodigitalstudio.ch) per TUTTI i tenant: con più clienti
# non usarla.
# ASSISTANT_LEAD_TO=


# ============================================================================
# Email via Resend: modulo contatti e preventivi dell'assistente
# ============================================================================

# Chiave API di Resend. Vuota = il modulo contatti passa a Formspree e i
# preventivi dell'assistente non partono per email.
RESEND_API_KEY=

# Mittente delle email: in produzione un indirizzo del dominio verificato su
# Resend, nella forma: Nome visibile <indirizzo@dominio>
# Vuoto = "Modolo Digital Studio <onboarding@resend.dev>", buono solo per prove.
CONTACT_FROM=


# ============================================================================
# Upstash Redis (facoltativo): contatori condivisi e copia dei preventivi
# ============================================================================
# Senza Upstash i contatori stanno nella memoria di ogni istanza del server.
# Con Upstash valgono per tutte le istanze e sopravvivono ai riavvii; con
# ASSISTANT_LEAD_COPY=true anche i preventivi vengono salvati, con scadenza
# automatica. Collegando Upstash dal Marketplace di Vercel le variabili
# arrivano da sole. Basta una delle due coppie.
# PRIVACY: prima di collegarlo aggiorna l'informativa: Upstash diventa un
# fornitore (contatori con gli hash di IP ed email e, con
# ASSISTANT_LEAD_COPY=true, copie dei preventivi).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=


# ============================================================================
# Sito
# ============================================================================

# Link al profilo Google Business: entra nei dati strutturati (JSON-LD) e nei
# link alle recensioni. Vuoto = niente profilo nei dati strutturati e link di
# riserva scritti nel codice. Viene fissato al momento della build.
NEXT_PUBLIC_GOOGLE_BUSINESS_URL=

# Link "scrivi una recensione" dietro i QR di /bewertung (CH) e /recensione (IT).
# Vuoti = il link scritto nel codice o, se manca, una ricerca su Google Maps.
GOOGLE_REVIEW_CH=
GOOGLE_REVIEW_IT=


# ============================================================================
# Solo per i test in locale: MAI su Vercel
# ============================================================================

# Indirizzo del server finto di Anthropic (node tests/assistant/mock-anthropic.mjs,
# porta 4010 o quella di MOCK_PORT): l'assistente risponde senza chiamate vere e
# senza costi. Con il mock ANTHROPIC_API_KEY può essere un valore qualsiasi,
# purché non vuoto.
# ANTHROPIC_BASE_URL=http://127.0.0.1:4010


# ============================================================================
# Assistente vocale (Modolo Voice AI)
# ============================================================================
# Spento finché VOICE_ENABLED non è "true". Un valore sbagliato non blocca il
# sito: vale il valore predefinito scritto qui e la modalità torna a "scripted"
# (una conversazione d'esempio scritta: niente microfono, niente costi).

# Interruttore generale: "true" accende la voce. Vuoto o altro = spenta.
# VOICE_ENABLED=false

# Modalità: scripted (esempio scritto, gratis), local (riconoscimento vocale
# del browser più Claude: per le prove), realtime (il prodotto vero, serve un
# fornitore voce). Se manca qualcosa che la modalità richiede, resta "scripted".
# In produzione "local" e "realtime" funzionano solo con l'archivio condiviso
# Upstash (KV_REST_API_URL e KV_REST_API_TOKEN, più su): senza, resta
# "scripted", perché i contatori della spesa, il blocco dei turni e la
# conversazione stessa vivrebbero nella memoria di ogni singola istanza.
# VOICE_MODE=scripted

# Chi risponde in modalità "local": anthropic (serve ANTHROPIC_API_KEY, più su)
# oppure mock (risposte finte, solo per i test: in produzione viene ignorato e
# resta "scripted").
# VOICE_BRAIN=anthropic

# Modello e token massimi per chiamata al modello (400-2000). Dentro ci stanno anche i
# pensieri del modello, non solo la risposta detta: sotto 400 puo' restare muto.
# VOICE_MODEL=claude-haiku-5-5
# VOICE_MAX_OUTPUT_TOKENS=1500

# Segreto con cui il server firma i gettoni di sessione: almeno 32 caratteri,
# casuale. In produzione senza questo segreto resta solo "scripted". In locale,
# se manca, il server ne crea uno a ogni avvio. Da generare con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# VOICE_SESSION_SECRET=

# Fornitore voce per "realtime": none (nessuno), mock (finto, solo per i test:
# niente audio vero) oppure openai (il fornitore vero, vedi il blocco qui sotto).
# Un fornitore vero vuole la sua chiave in VOICE_PROVIDER_API_KEY: senza chiave
# resta "scripted". La chiave resta sempre sul server.
# Un fornitore che avvisa quando una chiamata si collega e quanto è durata
# (eventi "started" e "ended" su /api/voice/tool) paga i minuti solo quando la
# chiamata c'è davvero; uno che non lo sa fare prenota a ogni sessione la
# chiamata intera, anche se il gettone non viene mai usato.
# VOICE_PROVIDER=none
# VOICE_PROVIDER_API_KEY=

# --- Voce con OpenAI (VOICE_PROVIDER=openai) ----------------------------------
# Con "openai" la voce di chi chiama va dal browser direttamente a OpenAI; il
# nostro server non tocca l'audio. La chiave invece resta sul server e il
# browser non la vede mai. Un valore sbagliato non blocca niente: vale quello
# predefinito e nei log compare una riga con il nome della variabile (mai il
# valore). Vuoto = valore predefinito.

# Chiave di OpenAI, letta solo con VOICE_PROVIDER=openai e solo se
# VOICE_PROVIDER_API_KEY è vuota.
# OPENAI_API_KEY=

# Modello: gpt-realtime-2.1 (predefinito) oppure gpt-realtime-2.1-mini. Il
# piccolo costa circa un quarto; il grande segue meglio istruzioni lunghe
# (il predefinito per questo). Con il modello grande il minuto costa parecchie
# volte più di quanto VOICE_COST_CHF_PER_MINUTE presume per il piccolo: alzate
# anche quel valore.
# VOICE_OPENAI_MODEL=

# Server di OpenAI: api.openai.com (predefinito) oppure eu.api.openai.com. Il
# secondo funziona solo con un progetto OpenAI creato con i dati in Europa.
# VOICE_OPENAI_HOST=

# Voce dell'assistente: alloy, ash, ballad, coral, echo, sage, shimmer, verse,
# marin (predefinita) o cedar.
# VOICE_OPENAI_VOICE=

# Come si capisce che chi chiama ha finito di parlare: semantic_vad
# (predefinito, guarda il senso della frase) oppure server_vad (aspetta un
# silenzio di durata fissa).
# VOICE_OPENAI_TURN=

# Solo con semantic_vad: quanto in fretta l'assistente prende la parola. low
# (predefinito, aspetta di più), medium, high oppure auto.
# VOICE_OPENAI_EAGERNESS=

# Solo con server_vad: il silenzio che chiude il turno, in millisecondi
# (200-2000, predefinito 1200); la sensibilità al rumore (da 0.1 a 0.9) e
# quanto audio tenere prima dell'inizio della frase, in millisecondi (0-1000).
# Gli ultimi due, se vuoti, non vengono mandati e decide OpenAI.
# VOICE_OPENAI_VAD_SILENCE_MS=
# VOICE_OPENAI_VAD_THRESHOLD=
# VOICE_OPENAI_VAD_PREFIX_MS=

# Quanto il modello ragiona prima di rispondere: minimal, low, medium, high o
# xhigh. Vuoto = non viene mandato e decide OpenAI.
# VOICE_OPENAI_REASONING=

# Trascrizione di quello che dice chi chiama, per i sottotitoli:
# gpt-transcribe (predefinito), gpt-4o-mini-transcribe oppure off (spenta).
# VOICE_OPENAI_TRANSCRIBE=

# Riduzione del rumore del microfono: near_field (predefinito, telefono o
# portatile vicino alla bocca), far_field (microfono lontano) oppure off.
# VOICE_OPENAI_NOISE=

# Velocità della voce, da 0.25 a 1.5. Vuoto = non viene mandata e decide OpenAI.
# VOICE_OPENAI_SPEED=

# Freni di una singola chiamata: token massimi per risposta (256-4096,
# predefinito 1024), risposte massime per chiamata (10-400, predefinito 80) e
# spesa massima stimata per chiamata in dollari (da 0.05 a 20; vuoto = un
# valore che dipende dal modello, più alto per il modello grande). Arrivata al
# freno, la chiamata viene chiusa.
# VOICE_OPENAI_MAX_OUTPUT_TOKENS=
# VOICE_OPENAI_MAX_RESPONSES=
# VOICE_OPENAI_MAX_CALL_USD=

# Segreto con cui il fornitore voce firma le chiamate agli strumenti
# (/api/voice/tool): almeno 16 caratteri, casuale, lo stesso impostato presso
# il fornitore. Vuoto o più corto = la rotta non esiste (404). Da generare con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# VOICE_PROVIDER_WEBHOOK_SECRET=

# Costo stimato al minuto in CHF del fornitore voce, usato per il tetto di
# spesa in "realtime". Vuoto = 0.25. In "local" non vale mai: lì si conta a
# ogni turno il costo vero del modello. Valori accettati: sopra 0, fino a 10.
# VOICE_COST_CHF_PER_MINUTE=

# Cambio fisso con cui il costo del modello (in dollari) entra nel tetto di
# spesa in franchi. Volutamente un po' alto: la spesa va contata per eccesso.
# Valori accettati da 0.5 a 2.
# VOICE_CHF_PER_USD=0.90

# Facoltativo: indirizzo a cui mandare gli avvisi sulla spesa del mese. Quando
# la spesa stimata di un tenant, o di tutti i tenant insieme, arriva al 50%,
# all'80% e al 100% del suo tetto, parte una e-mail (una sola per soglia e per
# mese), in italiano e senza dati di chi ha chiamato. Serve anche Resend
# (RESEND_API_KEY e CONTACT_FROM, più su): senza, l'avviso finisce solo nei log.
# VOICE_ALERT_EMAIL=

# Solo per provare in locale: "true" accende la casella finta delle e-mail.
# Senza RESEND_API_KEY una richiesta presa dall'assistente non può partire e chi
# chiama si sente dire che non ha funzionato. Con questo interruttore, e solo se
# Resend non è configurato, richieste, richiamate e riepiloghi a fine chiamata
# non partono: vengono stampati per intero nella console del server (righe che
# iniziano con "[voice dev outbox]") e contano come consegnati. Gli avvisi sulla
# spesa non passano di qui. In produzione viene ignorato, qualunque valore abbia.
# VOICE_DEV_OUTBOX=false

# Pagina interna di prova: "true" la attiva. Accende anche le conversazioni dal
# vivo con le aziende inventate delle demo: senza, sul sito le demo offrono
# solo l'esempio scritto, e dal vivo risponde solo l'assistente di Modolo.
# VOICE_LAB=false

# Pagina di vendita (/ai-receptionist, /de/ki-telefonassistent,
# /it/assistente-telefonico-ai): "true" la pubblica e la mette nella sitemap.
# Vuoto o altro = pagina non trovata (404). Si legge alla build: dopo averla
# cambiata serve un nuovo deploy.
# VOICE_LANDING=false

# --- Limiti della voce --------------------------------------------------------
# Valgono per tutti i tenant e hanno la precedenza sui valori scritti nel
# codice. Valori fuori misura vengono riportati entro limiti ragionevoli.
# Minuti e spesa sono un freno contro abusi e costi, non una fattura: giorni e
# mesi UTC, spesa stimata per eccesso. Le sessioni per
# indirizzo IP si contano su tutti i tenant insieme.

# Durata massima di una conversazione, in secondi (30-1800).
# VOICE_MAX_CALL_SECONDS=180

# Minuti di conversazione per tenant: al giorno (UTC) e al mese. Fermano solo
# "realtime", dove il minuto si paga. In "local" i minuti si contano ma non
# fermano niente (lì ferma la spesa del modello); solo 0 la spegne.
# VOICE_MINUTES_PER_DAY=30
# VOICE_MINUTES_PER_MONTH=300

# Tetto di spesa stimata per tenant e per mese, in CHF.
# VOICE_BUDGET_CHF_PER_MONTH=30

# Conversazioni contemporanee per tenant.
# VOICE_MAX_CONCURRENT=2

# Tetti per tutti i tenant insieme, controllati insieme a quelli di ogni
# tenant: minuti al giorno (UTC) e spesa stimata al mese, in CHF. 0 = niente
# conversazioni dal vivo.
# VOICE_GLOBAL_MINUTES_PER_DAY=60
# VOICE_GLOBAL_BUDGET_CHF_PER_MONTH=50
