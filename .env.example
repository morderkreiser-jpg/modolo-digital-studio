# Modello delle variabili d'ambiente del sito.
#
# Next.js NON legge questo file. In locale copialo in .env.local e compila solo
# quello che ti serve. Su Vercel le stesse variabili vanno in Settings ->
# Environment Variables, e dopo ogni modifica serve un nuovo deploy (Redeploy).
#
# Il repository è pubblico: in questo file mai valori veri.
# Le righe che iniziano con "#" sono facoltative: togli il "#" solo per cambiare
# il valore predefinito che vedi scritto.
# Guida completa all'assistente AI: docs/assistant/README.md


# ============================================================================
# Assistente AI (Anthropic Claude)
# ============================================================================

# Chiave API di Anthropic (Claude Console -> API keys). Obbligatoria per
# l'assistente: vuota = assistente spento e nessun bottone della chat.
ANTHROPIC_API_KEY=

# Interruttore d'emergenza: "false" spegne chat e widget senza togliere la chiave.
# ASSISTANT_ENABLED=true

# Modello principale, veloce ed economico.
# ASSISTANT_MODEL=claude-haiku-5-5

# Modello avanzato facoltativo: claude-sonnet-5-5 oppure claude-opus-5-5.
# Serve solo se ASSISTANT_MODEL_ROUTING è "advanced" o "auto".
# ASSISTANT_MODEL_ADVANCED=claude-sonnet-5-5

# fast = sempre il modello principale; advanced = sempre il modello avanzato;
# auto = il modello avanzato solo per le domande lunghe (oltre 400 caratteri)
# o con almeno tre punti interrogativi.
# ASSISTANT_MODEL_ROUTING=fast

# Quanto ragiona il modello prima di rispondere: low, medium o high.
# Più alto = più lento e più caro.
# ASSISTANT_EFFORT=low

# Token massimi in uscita per risposta (256-4096), ragionamento interno compreso.
# ASSISTANT_MAX_OUTPUT_TOKENS=2048

# Attesa massima per una risposta, in millisecondi (5000-120000). Su Vercel la
# funzione della chat dura al massimo 60 secondi: oltre 55000 non serve.
# ASSISTANT_TIMEOUT_MS=30000

# --- Limiti di spesa e di traffico --------------------------------------------
# Valgono per tutti i tenant e hanno la precedenza sui valori scritti nel codice.
# Il tetto di spesa vero si imposta nella Claude Console (Spend limits).

# Spesa stimata massima in dollari: per giorno (UTC) e per mese di calendario.
# ASSISTANT_DAILY_BUDGET_USD=1
# ASSISTANT_MONTHLY_BUDGET_USD=15

# Richieste chat al giorno (tutti i visitatori insieme) e messaggi per conversazione.
# ASSISTANT_DAILY_REQUEST_LIMIT=1000
# ASSISTANT_SESSION_MESSAGE_LIMIT=30

# --- Sicurezza e amministrazione ----------------------------------------------

# Segreto con cui IP ed email vengono pseudonimizzati (hash) nei contatori.
# Se manca viene ricavato dalla chiave Anthropic. In produzione è meglio un
# valore casuale lungo, da generare con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ASSISTANT_HASH_SALT=

# Token per leggere i consumi su /api/assistant/usage: almeno 24 caratteri,
# casuale (stesso comando di sopra). Se manca, l'indirizzo risponde 404.
# ASSISTANT_ADMIN_TOKEN=

# --- Richieste di preventivo --------------------------------------------------

# Giorni di conservazione dei preventivi (1-3650): il numero scritto accanto
# alla casella del modulo e nell'email, e la scadenza delle copie su Upstash.
# Se manca vale il valore del tenant (Modolo: 365, i 12 mesi dell'informativa:
# se lo cambi, cambia anche l'informativa).
# ASSISTANT_LEAD_RETENTION_DAYS=365

# Copia dei preventivi su Upstash: "true" salva ogni richiesta anche nel
# database, con la scadenza qui sopra. Serve Upstash (blocco più in basso);
# senza "true" Upstash tiene solo i contatori. Prima di attivarla aggiorna
# l'informativa (docs/assistant/README.md, sezione 10).
# ASSISTANT_LEAD_COPY=false

# Destinatario delle email dei preventivi. Sostituisce l'indirizzo del tenant
# (Modolo: info@modolodigitalstudio.ch) per TUTTI i tenant: con più clienti
# non usarla.
# ASSISTANT_LEAD_TO=


# ============================================================================
# Email via Resend: modulo contatti e preventivi dell'assistente
# ============================================================================

# Chiave API di Resend. Vuota = il modulo contatti passa a Formspree e i
# preventivi dell'assistente non partono per email.
RESEND_API_KEY=

# Mittente delle email: in produzione un indirizzo del dominio verificato su
# Resend, nella forma: Nome visibile <indirizzo@dominio>
# Vuoto = "Modolo Digital Studio <onboarding@resend.dev>", buono solo per prove.
CONTACT_FROM=


# ============================================================================
# Upstash Redis (facoltativo): contatori condivisi e copia dei preventivi
# ============================================================================
# Senza Upstash i contatori stanno nella memoria di ogni istanza del server.
# Con Upstash valgono per tutte le istanze e sopravvivono ai riavvii; con
# ASSISTANT_LEAD_COPY=true anche i preventivi vengono salvati, con scadenza
# automatica. Collegando Upstash dal Marketplace di Vercel le variabili
# arrivano da sole. Basta una delle due coppie.
# PRIVACY: prima di collegarlo aggiorna l'informativa: Upstash diventa un
# fornitore (contatori con gli hash di IP ed email e, con
# ASSISTANT_LEAD_COPY=true, copie dei preventivi).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=


# ============================================================================
# Sito
# ============================================================================

# Link al profilo Google Business: entra nei dati strutturati (JSON-LD) e nei
# link alle recensioni. Vuoto = niente profilo nei dati strutturati e link di
# riserva scritti nel codice. Viene fissato al momento della build.
NEXT_PUBLIC_GOOGLE_BUSINESS_URL=

# Link "scrivi una recensione" dietro i QR di /bewertung (CH) e /recensione (IT).
# Vuoti = il link scritto nel codice o, se manca, una ricerca su Google Maps.
GOOGLE_REVIEW_CH=
GOOGLE_REVIEW_IT=


# ============================================================================
# Solo per i test in locale: MAI su Vercel
# ============================================================================

# Indirizzo del server finto di Anthropic (node tests/assistant/mock-anthropic.mjs,
# porta 4010 o quella di MOCK_PORT): l'assistente risponde senza chiamate vere e
# senza costi. Con il mock ANTHROPIC_API_KEY può essere un valore qualsiasi,
# purché non vuoto.
# ANTHROPIC_BASE_URL=http://127.0.0.1:4010


# ============================================================================
# Assistente vocale (Modolo Voice AI)
# ============================================================================
# Spento finché VOICE_ENABLED non è "true". Un valore sbagliato non blocca il
# sito: vale il valore predefinito scritto qui e la modalità torna a "scripted"
# (una conversazione d'esempio scritta: niente microfono, niente costi).

# Interruttore generale: "true" accende la voce. Vuoto o altro = spenta.
# VOICE_ENABLED=false

# Modalità: scripted (esempio scritto, gratis), local (riconoscimento vocale
# del browser più Claude: per le prove), realtime (il prodotto vero, serve un
# fornitore voce). Se manca qualcosa che la modalità richiede, resta "scripted".
# VOICE_MODE=scripted

# Chi risponde in modalità "local": anthropic (serve ANTHROPIC_API_KEY, più su)
# oppure mock (risposte finte, solo per i test).
# VOICE_BRAIN=anthropic

# Modello e token massimi per risposta (100-1200: al telefono si parla corto).
# VOICE_MODEL=claude-haiku-5-5
# VOICE_MAX_OUTPUT_TOKENS=400

# Segreto con cui il server firma i gettoni di sessione: almeno 32 caratteri,
# casuale. In produzione senza questo segreto resta solo "scripted". In locale,
# se manca, il server ne crea uno a ogni avvio. Da generare con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# VOICE_SESSION_SECRET=

# Fornitore voce per "realtime": none (nessuno) oppure mock (finto, solo per i
# test: niente audio vero). I fornitori veri verranno aggiunti più avanti, con
# la loro chiave in VOICE_PROVIDER_API_KEY. La chiave resta sempre sul server.
# VOICE_PROVIDER=none
# VOICE_PROVIDER_API_KEY=

# Costo stimato al minuto in CHF, usato per il tetto di spesa. Vuoto = 0.25 in
# "realtime" e 0.02 in "local". Valori accettati: sopra 0, fino a 10.
# VOICE_COST_CHF_PER_MINUTE=

# Facoltativo: indirizzo a cui mandare gli avvisi sulla spesa del mese.
# VOICE_ALERT_EMAIL=

# Pagina interna di prova: "true" la attiva.
# VOICE_LAB=false

# --- Limiti della voce --------------------------------------------------------
# Valgono per tutti i tenant e hanno la precedenza sui valori scritti nel
# codice. Valori fuori misura vengono riportati entro limiti ragionevoli.

# Durata massima di una conversazione, in secondi (30-1800).
# VOICE_MAX_CALL_SECONDS=180

# Minuti di conversazione per tenant: al giorno (UTC) e al mese.
# VOICE_MINUTES_PER_DAY=30
# VOICE_MINUTES_PER_MONTH=300

# Tetto di spesa stimata per tenant e per mese, in CHF.
# VOICE_BUDGET_CHF_PER_MONTH=30

# Conversazioni contemporanee per tenant.
# VOICE_MAX_CONCURRENT=2
